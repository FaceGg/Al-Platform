# Prebuilt-dist image for proxy-blocked environments: build dist on the host
# (npm run build) first, then pack it with the local nginx base image.
# Usage: DOCKER_BUILDKIT=0 docker build -f Dockerfile.prebuilt -t agent_spot_welding-frontend .
FROM nginx:stable-alpine
COPY nginx-default.conf /etc/nginx/conf.d/default.conf
COPY html-dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
