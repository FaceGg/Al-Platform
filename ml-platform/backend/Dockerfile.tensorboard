FROM cgr.dev/chainguard/wolfi-base:latest@sha256:6a8dca4c2153cfc11d559cfa6172c187b896423d833f3d48a4c1c44ab55596d7
USER 0
WORKDIR /app
RUN set -eu; \
    printf '%s\n' 'https://packages.wolfi.dev/os' > /etc/apk/repositories; \
    for attempt in 1 2 3; do \
        if apk add --no-cache python-3.11=3.11.16-r1 py3.11-pip=26.2.1-r0 glibc libgomp; then \
            exit 0; \
        fi; \
        if [ "$attempt" -eq 3 ]; then \
            exit 1; \
        fi; \
        sleep "$attempt"; \
    done
RUN python3.11 -c "import sqlite3"
RUN addgroup -S -g 1000 app && adduser -S -D -H -h /home/app -u 1000 -G app app
RUN python3.11 -m pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/
COPY requirements.txt .
# Keep the CPU image free of XGBoost's Linux NCCL dependency.
RUN --mount=type=cache,target=/root/.cache/pip \
    set -eu; \
    python3.11 -m pip install --no-deps --retries 10 --resume-retries 20 --timeout 120 \
        "xgboost==3.2.*" "catboost==1.2.*"; \
    sed '/^xgboost==/d; /^catboost==/d' requirements.txt > /tmp/requirements-without-boost.txt; \
    python3.11 -m pip install --retries 10 --resume-retries 20 --timeout 120 \
        graphviz plotly six \
        -r /tmp/requirements-without-boost.txt
COPY . .
RUN mkdir -p /home/app /var/lib/tensorboard/runs /var/lib/ml-platform/inference-cache \
    /tmp/ml-platform \
    && chown -R app:app /home/app /var/lib/tensorboard \
    /var/lib/ml-platform /tmp/ml-platform

EXPOSE 6006
ENV HOME=/home/app
USER 1000:1000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:6006/openapi.json', timeout=3)" || exit 1
CMD ["uvicorn", "app.tensorboard_gateway.app:app", "--host", "0.0.0.0", "--port", "6006", "--workers", "1"]
