FROM python:3.11-slim
WORKDIR /app
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --retries 10 --timeout 120 -r requirements.txt
RUN groupadd --gid 1000 app && useradd --uid 1000 --gid app --create-home app
COPY . .
RUN mkdir -p /var/lib/tensorboard/runs \
    && chown -R app:app /var/lib/tensorboard/runs

EXPOSE 6006
USER app
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:6006/openapi.json', timeout=3)" || exit 1
CMD ["uvicorn", "app.tensorboard_gateway.app:app", "--host", "0.0.0.0", "--port", "6006", "--workers", "1"]
