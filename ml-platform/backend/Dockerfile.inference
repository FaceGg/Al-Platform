FROM cgr.dev/chainguard/wolfi-base:latest@sha256:30f03343947c7ae3581fda727a6e2aa7b8ce7009b7bfc2ab8d5c9483ace5812f
USER 0
WORKDIR /app
RUN set -eu; \
    for attempt in 1 2 3; do \
        if apk add --no-cache python-3.11=3.11.16-r1 py3.11-pip=26.2.1-r0; then \
            exit 0; \
        fi; \
        if [ "$attempt" -eq 3 ]; then \
            exit 1; \
        fi; \
        sleep "$attempt"; \
    done
RUN addgroup -S -g 1000 app && adduser -S -D -H -h /home/app -u 1000 -G app app
RUN python3.11 -m pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    python3.11 -m pip install --retries 10 --resume-retries 20 --timeout 120 -r requirements.txt
COPY . .
RUN mkdir -p /home/app /var/lib/ml-platform/inference-cache /tmp/ml-platform \
    && chown -R app:app /home/app /var/lib/ml-platform/inference-cache /tmp/ml-platform

EXPOSE 7000
ENV HOME=/home/app
USER 1000:1000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:7000/health', timeout=3)" || exit 1
CMD ["uvicorn", "app.inference_runtime.app:build_runtime_app", "--factory", "--host", "0.0.0.0", "--port", "7000", "--workers", "1"]
