APP_MODE=local
DATABASE_URL=sqlite:///./ml_platform.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30

# SECRET_KEY_FILE=/run/secrets/jwt-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

TASK_BACKEND=local
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
# REDIS_EVENTS_URL=redis://redis:6379/2
TASK_SOFT_TIMEOUT_SECONDS=3600
TASK_HARD_TIMEOUT_SECONDS=3900

ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_DIR=./artifact_store
# MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=ml-platform
# MINIO_ACCESS_KEY=replace-with-access-key
# MINIO_ACCESS_KEY_FILE=/run/secrets/minio-access-key
# MINIO_SECRET_KEY=replace-with-secret-key
# MINIO_SECRET_KEY_FILE=/run/secrets/minio-secret-key
MINIO_SECURE=false

# MLFLOW_TRACKING_URI=http://mlflow:5000
# MLFLOW_BACKEND_STORE_URI=postgresql+psycopg://mlflow:replace-me@postgres/mlflow
# MLFLOW_ARTIFACT_ROOT=s3://ml-platform/mlflow
# TENSORBOARD_GATEWAY_URL=http://tensorboard-gateway:6006
# TENSORBOARD_SESSION_SECRET_FILE=/run/secrets/tensorboard-session-secret
TENSORBOARD_SESSION_TTL_SECONDS=300
TENSORBOARD_IDLE_TIMEOUT_SECONDS=600
TRAINING_CHECKPOINT_INTERVAL_EPOCHS=5
TRAINING_STALE_AFTER_SECONDS=300

LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo
