# AI Model Training Platform - Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./data/ml_platform.db
ARTIFACT_STORAGE_DIR=./data/artifacts
ML_PLATFORM_RUNTIME_DIR=./temp_test/runtime
ML_PLATFORM_TEMP_DIR=./temp_test/data

# Production experiment services
# MLFLOW_TRACKING_URI=http://mlflow:5000
# MLFLOW_BACKEND_STORE_URI=postgresql+psycopg://ml_platform:replace-me@postgres:5432/mlflow
# MLFLOW_ARTIFACT_ROOT=s3://ml-platform/mlflow
# TENSORBOARD_GATEWAY_URL=http://tensorboard-gateway:6006
# TENSORBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters

# Security
SECRET_KEY=change-me-to-a-random-secret-key

# LLM Configuration (for AI Chat & RAG)
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# JWT
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Upload limits
MAX_UPLOAD_SIZE_MB=500
