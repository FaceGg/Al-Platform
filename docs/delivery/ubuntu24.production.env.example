# Copy this file to the repository root as .env. Never commit the populated file.
# Use openssl rand -hex 32 for every REPLACE_* value.

# Persistent PostgreSQL database.
POSTGRES_DB=ml_platform
POSTGRES_USER=ml_platform
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_HEX_PASSWORD
DATABASE_URL=postgresql+psycopg://ml_platform:REPLACE_WITH_URL_SAFE_HEX_PASSWORD@postgres:5432/ml_platform

# Application signing key. Must be at least 32 characters and not the source default.
SECRET_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Celery and Redis event channels.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_EVENTS_URL=redis://redis:6379/2

# MinIO object storage. Keep the two credential pairs equal for this bundled deployment.
MINIO_ROOT_USER=mlplatform
MINIO_ROOT_PASSWORD=REPLACE_WITH_URL_SAFE_HEX_PASSWORD
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=ml-platform
MINIO_ACCESS_KEY=mlplatform
MINIO_SECRET_KEY=REPLACE_WITH_URL_SAFE_HEX_PASSWORD
MINIO_SECURE=false
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
# Use the cpuv1 images on hosts whose CPU does not support x86-64-v2.
MINIO_IMAGE=minio/minio:RELEASE.2025-07-23T15-54-02Z-cpuv1
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-07-21T05-28-08Z-cpuv1

# MLflow.
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg://ml_platform:REPLACE_WITH_URL_SAFE_HEX_PASSWORD@postgres:5432/mlflow
MLFLOW_ARTIFACT_ROOT=s3://ml-platform/mlflow

# TensorBoard gateway and private inference runtime.
TENSORBOARD_GATEWAY_URL=http://tensorboard-gateway:6006
TENSORBOARD_SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
INFERENCE_RUNTIME_URL=http://inference-runtime:7000
INFERENCE_INTERNAL_SECRET=REPLACE_WITH_64_HEX_CHARACTERS

# Optional LLM functions. Leave blank when not used.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Management services remain local to the Ubuntu host by default.
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1
MINIO_BIND_ADDRESS=127.0.0.1
